# Backend environment variables — names and safe placeholders only.
# Never commit real values.

# Supabase (unprovisioned in demo — see STATUS_INDEX.md open items)
SUPABASE_URL=your-project-ref-here
SUPABASE_SERVICE_KEY=your-service-key-here

# Upstash Redis
UPSTASH_REDIS_URL=your-redis-url-here
UPSTASH_REDIS_REST_TOKEN=your-redis-rest-token-here

# LLM providers (Capacity Manager, per QUORUM_CONFIGURATION_CONSTANTS.md §8)
GEMINI_API_KEY=your-key-here
GROQ_API_KEY=your-key-here
TAVILY_API_KEY=your-key-here

# Auth
JWT_SIGNING_KEY=change-me-in-real-deployment

# Google OAuth (Gmail/Calendar ingestion + real send/booking actions —
# server-side token exchange, per QUORUM_ARCHITECTURE_DESIGN_DOCUMENT.md
# section 14.2). Test against a dedicated sandbox Google account only,
# never a real personal Gmail — see CLAUDE.md Rule 5.
GOOGLE_OAUTH_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret-here

# Observability
LANGFUSE_PUBLIC_KEY=your-key-here
LANGFUSE_SECRET_KEY=your-key-here